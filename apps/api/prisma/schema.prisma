generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Player {
  accountId    String?
  account      Account?            @relation(fields: [accountId], references: [id], onDelete: SetNull)
  id           String              @id
  name         String
  createdAt    DateTime            @default(now())
  sessions     PlayerSession[]
  hostedRooms  GameRoom[]
  participants RoomParticipant[]
  guesses      RoundGuess[]
  rounds       RoundPlayerResult[]
  matches      MatchResult[]
}

model PlayerSession {
  id        String   @id
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([playerId])
  @@index([expiresAt])
}

enum RoundMode {
  timed
  untimed
}

model GameRoom {
  id           String            @id
  code         String
  name         String
  maxPlayers   Int
  roundMode    RoundMode         @default(timed)
  gameMode     String            @default("ffa")
  roundCount   Int               @default(5)
  roundSeconds Int               @default(90)
  hostId       String
  host         Player            @relation(fields: [hostId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  participants RoomParticipant[]
  matches      GameMatch[]

  @@index([code])
}

model RoomParticipant {
  roomId    String
  playerId  String
  room      GameRoom @relation(fields: [roomId], references: [id])
  player    Player   @relation(fields: [playerId], references: [id])
  createdAt DateTime @default(now())

  @@id([roomId, playerId])
}

model GameMatch {
  id        String        @id
  roomId    String
  room      GameRoom      @relation(fields: [roomId], references: [id])
  roundMode RoundMode     @default(timed)
  gameMode  String        @default("ffa")
  roundCount Int          @default(5)
  roundSeconds Int        @default(90)
  winnerTeamId String?
  teamResults Json?
  createdAt DateTime      @default(now())
  endedAt   DateTime?
  rounds    GameRound[]
  results   MatchResult[]

  @@index([roomId])
}

model GameRound {
  id        String              @id
  matchId   String
  match     GameMatch           @relation(fields: [matchId], references: [id])
  number    Int
  answer    String
  startedAt DateTime
  endedAt   DateTime
  guesses   RoundGuess[]
  results   RoundPlayerResult[]

  @@unique([matchId, number])
}

model RoundGuess {
  roundId   String
  playerId  String
  round     GameRound @relation(fields: [roundId], references: [id])
  player    Player    @relation(fields: [playerId], references: [id])
  attempt   Int
  word      String
  marks     Json
  createdAt DateTime

  @@id([roundId, playerId, attempt])
}

model RoundPlayerResult {
  roundId   String
  playerId  String
  round     GameRound @relation(fields: [roundId], references: [id])
  player    Player    @relation(fields: [playerId], references: [id])
  status    String
  points    Int
  attempts  Int
  solveMs   Int?
  elapsedMs Int?
  teamId    String?

  @@id([roundId, playerId])
}

model MatchResult {
  matchId   String
  playerId  String
  match     GameMatch @relation(fields: [matchId], references: [id])
  player    Player    @relation(fields: [playerId], references: [id])
  rank      Int
  points    Int
  solved    Int
  solveMs   Int
  attempts  Int
  fastestMs Int?
  fastestWord String?
  teamId      String?

  @@id([matchId, playerId])
}

model DictionaryWord {
  word     String  @id
  isAnswer Boolean @default(false)
}

model Account {
  id           String           @id @default(uuid())
  username     String           @unique
  passwordHash String
  rating       Int              @default(1000)
  ratedGames   Int              @default(0)
  wins         Int              @default(0)
  winStreak    Int              @default(0)
  bestWinStreak Int             @default(0)
  peakRating   Int              @default(1000)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  sessions     AccountSession[]
  ratingEvents RatingEvent[]
  tickets      SoloChallenge[]
  players      Player[]
  dailyAttempts DailyAttempt[]

  @@index([rating(sort: Desc), username])
}

model AccountSession {
  id        String   @id
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([accountId])
  @@index([expiresAt])
}

model RatingEvent {
  id        String   @id
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  source    String
  before    Int
  delta     Int
  after     Int
  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
}

model SoloChallenge {
  id        String   @id @default(uuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  answer    String
  expiresAt DateTime
  playedAt  DateTime?
  createdAt DateTime @default(now())

  @@index([accountId, playedAt, expiresAt])
}

model DailyChallenge {
  date      String         @id
  words     String[]
  createdAt DateTime       @default(now())
  attempts  DailyAttempt[]
}

model DailyAttempt {
  date        String
  accountId   String
  challenge   DailyChallenge @relation(fields: [date], references: [date])
  account     Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  round       Int            @default(1)
  version     Int            @default(0)
  rounds      Json
  solved      Int            @default(0)
  points      Int            @default(0)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@id([date, accountId])
  @@index([date, solved(sort: Desc), points(sort: Desc)])
}
