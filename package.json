{
  "name": "kelime-arenasi",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node apps/api/scripts/generate.mjs",
    "dev": "concurrently -k \"npm run dev -w @arena/api\" \"npm run dev -w @arena/web\"",
    "build": "npm run check && npm run build:api && npm run build -w @arena/web",
    "check": "tsc --noEmit",
    "test": "tsx --test packages/game-engine/src/*.test.ts apps/api/src/*.test.ts",
    "migrate": "node --experimental-wasm-modules --env-file-if-exists=.env apps/api/scripts/migrate.mjs",
    "build:api": "esbuild apps/api/src/main.ts --bundle --format=esm --platform=node --target=node22 --packages=external --alias:@arena/shared=./packages/shared/src/index.ts --alias:@arena/game-engine=./packages/game-engine/src/index.ts --outfile=apps/api/dist/main.mjs"
  },
  "devDependencies": {
    "@prisma/client-generator-ts": "7.10.1",
    "@prisma/config": "7.10.1",
    "@prisma/driver-adapter-utils": "7.10.1",
    "@prisma/internals": "7.10.1",
    "@prisma/schema-engine-wasm": "8.1.0-1.d1b3f377ca835d73fd50954a5e22128b9ebdd6b8",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "esbuild": "~0.28.2",
    "pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "~5.8.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "overrides": {
    "effect": "3.22.5"
  }
}
