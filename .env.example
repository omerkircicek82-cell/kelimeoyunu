# Geliştirme değerleri. Üretimde POSTGRES_PASSWORD değerini openssl rand -hex 32 ile değiştirin.
POSTGRES_PASSWORD=arena_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://arena:arena_dev@127.0.0.1:5432/arena
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# Docker Compose Nginx yayını. LAN'dan erişim için BIND_ADDRESS=0.0.0.0 kullanın.
BIND_ADDRESS=127.0.0.1
PUBLIC_PORT=8080
